<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application android:supportsRtl="true">
        <activity
            android:name=".AdkPlaygroundActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.hehe.sketch.action.SKETCH_ENTRY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="dev.hehe.sketch.entry.TITLE"
                android:value="@string/adk_title" />
            <meta-data
                android:name="dev.hehe.sketch.entry.SUMMARY"
                android:value="@string/adk_summary" />
            <meta-data
                android:name="dev.hehe.sketch.entry.ORDER"
                android:value="50" />
            <meta-data
                android:name="dev.hehe.sketch.entry.MODULE"
                android:value="feat-adk" />
            <meta-data
                android:name="dev.hehe.sketch.entry.TAGS"
                android:value="ai,agent,adk,mcp,quickjs" />
            <meta-data
                android:name="dev.hehe.sketch.entry.ACCENT_COLOR"
                android:resource="@color/adk_entry_accent" />
        </activity>
    </application>

</manifest>
